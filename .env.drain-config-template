# ============================================
# DRAIN QUEUE CONFIGURATION (CRITICAL - ADD THESE)
# ============================================
# These are REQUIRED for the drain system to work properly

# Node.js Order Response Batching
ORDER_RES_BATCH_ENABLED=true
ORDER_RES_BATCH_SIZE=200
ORDER_RES_BATCH_TIMEOUT=200
ORDER_RES_BATCH_MAX_SIZE=500

# Laravel Drain Job Configuration
DRAIN_BATCH_SIZE=200

# Queue Configuration (MUST be Redis)
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis

# ============================================
# REDIS CONFIGURATION (Consolidated)
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=2
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ============================================
# MQTT CONFIGURATION
# ============================================
MQTT_BROKER=mqtt://109.199.112.65:1883
MQTT_PUBLISH_TIMEOUT_MS=20000
MQTT_PUBLISH_MODE=queue
MQTT_USE_QUEUE=true
MQTT_PUBLISH_QUEUE=egf_mqtt_publish_queue

# ============================================
# EXISTING BATCH CONFIGURATION (Keep these)
# ============================================
BATCH_ACTION_CHUNK_SIZE=500
BATCH_DB_TX_CHUNK_SIZE=200
BATCH_INSERT_MAX_ATTEMPTS=5
BATCH_INSERT_BASE_BACKOFF_MS=100
BATCH_ACTION_MAX_PER_MIN=5000

PING_BATCH_PROCESS_CHUNK_SIZE=80
PING_BATCH_CHUNK_DELAY_MS=50

# ============================================
# QUEUE TUNING
# ============================================
QUEUE_RETRY_AFTER=20
QUEUE_BLOCK_FOR=3
QUEUE_MAX_JOBS=400
QUEUE_MAX_TIME=600
QUEUE_FAILED_DRIVER=database

# ============================================
# WORKER SETTINGS
# ============================================
WORKER_MEMORY_LIMIT=192
QUEUE_MEMORY_LIMIT=128
ACTION_QUEUE_WORKERS=2
ACTION_BATCH_SIZE=15
ACTION_PROCESSING_DELAY=0

# ============================================
# PERFORMANCE FLAGS
# ============================================
HIGH_PERFORMANCE_ENABLED=true
LOAD_TEST_ENABLED=false

# ============================================
# INSTRUCTIONS
# ============================================
# 1. Copy the lines from "DRAIN QUEUE CONFIGURATION" section above
# 2. Add them to your production .env file
# 3. Remove any duplicate REDIS_DB, MQTT_BROKER, or REDIS_URL lines
# 4. Restart services:
#    - pm2 restart mqtt-handler
#    - sudo supervisorctl restart laravel-queues-ultra:*
# 5. Verify with: pm2 show mqtt-handler | grep ORDER_RES
