# Optimized Environment Variables for High-Load Order Response Processing
# Add these to your .env file or set as environment variables

# ============================================================================
# CRITICAL: QUEUE CONFIGURATION (REQUIRED)
# ============================================================================
QUEUE_CONNECTION=redis
# MUST be 'redis' for async processing. Never use 'sync' in production!

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CONNECTION=default
REDIS_QUEUE_CONNECTION=queue

# ============================================================================
# ORDER RESPONSE BATCH PROCESSING (Laravel)
# ============================================================================

# Maximum actions in a single sub-batch before splitting
# If a batch exceeds this, it will be split into multiple jobs
# Higher = fewer jobs but larger payloads
# Lower = more jobs but easier to process
ORDER_RES_SUB_BATCH_SIZE=500

# Actions processed per DB chunk within a job
# Higher = faster but more DB load per query
# Lower = slower but more granular
ORDER_RES_BATCH_CHUNK_SIZE=150

# Delay in milliseconds between DB chunks (0 = no delay)
# Set to 0 when using queue workers (they provide natural pacing)
# Set to 20-50 if experiencing DB lock contention
ORDER_RES_BATCH_CHUNK_DELAY_MS=0

# ============================================================================
# NODE.JS MQTT HANDLER (Set via process.env or PM2 ecosystem)
# ============================================================================

# Enable batching for order/res responses
ORDER_RES_BATCH_ENABLED=true

# Actions accumulated before HTTP flush
# Higher = fewer HTTP calls but more latency
# Lower = more HTTP calls but faster processing
ORDER_RES_BATCH_SIZE=300

# Time in milliseconds before forcing a batch flush
# Lower = faster flush but may create small batches
# Higher = larger batches but more latency
ORDER_RES_BATCH_TIMEOUT=200

# Emergency flush threshold (prevents unbounded memory growth)
# If accumulator reaches this size, flush immediately
ORDER_RES_BATCH_MAX_SIZE=1000

# HTTP timeout for batch endpoint calls (milliseconds)
MQTT_HTTP_TIMEOUT=20000

# Maximum concurrent HTTP requests from Node to Laravel
MQTT_MAX_INFLIGHT=200

# ============================================================================
# QUEUE WORKER CONFIGURATION (Supervisor)
# ============================================================================

# See laravel-workers-ultra-batch.conf for detailed worker configuration
# Key settings:
# - 16 workers on 'high' queue (for order response jobs)
# - 8 workers on 'optimized-actions' queue (for other action jobs)
# - --sleep=0 for maximum throughput
# - --max-jobs=5000 before worker restart
# - --memory=256 (MB) per worker limit

# ============================================================================
# PERFORMANCE TUNING GUIDE
# ============================================================================

# For 4,000 actions/5 seconds (current scenario):
# - ORDER_RES_BATCH_SIZE=300 → ~14 HTTP calls
# - ORDER_RES_BATCH_CHUNK_SIZE=150 → ~27 chunks across jobs
# - 16 workers → ~2 seconds total processing time
# Expected throughput: 2,400 actions/second

# For 10,000 actions/5 seconds (future scaling):
# - Increase ORDER_RES_BATCH_SIZE to 500
# - Increase ORDER_RES_SUB_BATCH_SIZE to 800
# - Add 8 more queue workers (24 total)
# Expected throughput: 3,600 actions/second

# For lower load (<1,000 actions/5 seconds):
# - Reduce ORDER_RES_BATCH_SIZE to 100
# - Reduce workers to 8
# - Set ORDER_RES_BATCH_CHUNK_DELAY_MS=20 for gentler DB load

# ============================================================================
# MONITORING & DEBUGGING
# ============================================================================

# Enable detailed logging (set in config/logging.php)
LOG_LEVEL=debug

# Queue monitoring
# Run: php artisan queue:monitor redis:high --max-wait=60

# Redis metrics
# Key pattern: order_res_batch_metrics:{YYYYMMDDHHmm}
# Watch: redis-cli hgetall "order_res_batch_metrics:$(date +%Y%m%d%H%M)"

# ============================================================================
# HEALTH CHECKS
# ============================================================================

# Verify queue is working:
# 1. Check .env: grep QUEUE_CONNECTION .env
# 2. Test Redis: redis-cli ping
# 3. Monitor queue: redis-cli llen queues:high
# 4. Check workers: sudo supervisorctl status laravel-queues-ultra:*
# 5. Test dispatch: php artisan tinker
#    >>> dispatch(new \App\Jobs\ProcessOrderResponseBatchJob(
#          [['order_id'=>1,'user_id'=>1,'status'=>'done']], 'done', 'test'
#        ));

# ============================================================================
# NOTES
# ============================================================================

# 1. QUEUE_CONNECTION=redis is CRITICAL - without this, all optimizations are disabled
# 2. Ensure supervisor is running the queue workers: sudo supervisorctl status
# 3. Monitor Redis memory: redis-cli info memory
# 4. Check failed jobs: php artisan queue:failed
# 5. For extreme loads (>10K/5sec), consider multiple Redis instances or partitioning
