# Queue Processing Configuration for MQTT Actions
# This configuration enables the new queued processing system to handle
# thousands of concurrent action updates without overwhelming the database

# Enable queue-based processing for MQTT actions
# Set to true to use the new batch processing system
# Set to false to use immediate processing (fallback)
MQTT_USE_QUEUE=true

# Auto-create missing actions during processing
# Set to true to automatically create actions that don't exist
MQTT_AUTO_CREATE_MISSING=true

# Queue Configuration
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Database Configuration (optimized for connection pooling)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Additional MySQL settings for better connection handling
DB_TIMEOUT=60
DB_RETRY_AFTER=15

# Job Queue Settings
QUEUE_FAILED_JOBS_TABLE=failed_jobs
QUEUE_BATCHING_TABLE=job_batches

# MQTT Settings
MQTT_HOST=your_mqtt_host
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
