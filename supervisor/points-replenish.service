[Unit]
Description=Replenish Points for Zero Balance Users
After=network.target mysql.service redis.service

[Service]
Type=oneshot
User=egfollow
Group=egfollow
WorkingDirectory=/home/egfollow/htdocs/egfollow.com
ExecStart=/usr/bin/php /home/egfollow/htdocs/egfollow.com/artisan points:replenish-zero-balance
StandardOutput=append:/home/egfollow/htdocs/egfollow.com/storage/logs/replenish-zero-balance.log
StandardError=append:/home/egfollow/htdocs/egfollow.com/storage/logs/replenish-zero-balance.log

[Install]
WantedBy=multi-user.target
