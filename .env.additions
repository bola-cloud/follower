# Add these lines to your existing .env file - SAFE to add, won't break existing system

# Performance tuning options (optional)
MQTT_PROCESSING_MODE=queue # Use 'queue' to keep current system, 'bulk' for new high-performance mode
BULK_ACTION_BATCH_SIZE=100 # Smaller batch size for safety
MQTT_BATCH_SIZE=50 # Conservative batch size

# High-performance processor settings (only used if you enable it)
HIGH_PERFORMANCE_ENABLED=false # Set to true only after testing

# Load testing settings
LOAD_TEST_ENABLED=false # Only enable for testing
