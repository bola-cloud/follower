# High-Performance Environment Configuration
# Optimized for 3 vCPU + 8GB RAM Server
# Target: 2 orders/minute × 1000 users = 2000 actions/minute

# --- Core Drivers ---
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- Redis / Queue Configuration ---
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_QUEUE=default
REDIS_CONNECTION=default

# Redis Connection Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Optimized Redis DB allocation for 8GB server
REDIS_DB=0          # default queue
REDIS_CACHE_DB=1    # cache
REDIS_QUEUE_DB=2    # high-priority queues

# --- Queue Performance Tuning (3 vCPU optimized) ---
QUEUE_RETRY_AFTER=20
QUEUE_BLOCK_FOR=3
QUEUE_MAX_JOBS=400
QUEUE_MAX_TIME=600

# --- MQTT Processing (Server optimized) ---
MQTT_USE_QUEUE=true
MQTT_AUTO_CREATE_MISSING=true
MQTT_PROCESSING_MODE=queue
MQTT_BATCH_SIZE=30                   # Optimized for 3 vCPU
MQTT_MAX_CONCURRENT=15               # Conservative for server
BULK_ACTION_BATCH_SIZE=75            # Smaller batches

# --- Database Performance ---
DB_TIMEOUT=20
DB_RETRY_AFTER=8
DB_CONNECTION_LIMIT=15               # Conservative pooling

# --- Performance Flags ---
HIGH_PERFORMANCE_ENABLED=true
LOAD_TEST_ENABLED=false

# --- Action Queue Settings (Server optimized) ---
ACTION_QUEUE_WORKERS=2               # Match numprocs in supervisor
ACTION_BATCH_SIZE=15                 # Smaller batches for stability
ACTION_PROCESSING_DELAY=0

# --- Memory Limits (8GB server) ---
WORKER_MEMORY_LIMIT=192              # MB per worker
QUEUE_MEMORY_LIMIT=128               # MB for action workers

# --- Logging ---
LOG_CHANNEL=single
LOG_LEVEL=warning                    # Minimal logging for performance
QUEUE_FAILED_DRIVER=database
