# Maximum Performance Configuration for 3 vCPU / 8GB RAM Server
# Optimized for 3000+ actions/minute with aggressive queue processing

APP_NAME="EgFollow Ultra Performance"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://egfollow.com

LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database (use your actual credentials)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=egfollow_production
DB_USERNAME=egfollow
DB_PASSWORD=your_password_here

# Broadcast (disabled for max performance)
BROADCAST_DRIVER=null

# Cache - Redis for maximum performance
CACHE_DRIVER=redis
FILESYSTEM_DISK=local

# Queue - Redis with aggressive settings
QUEUE_CONNECTION=redis

# Redis Configuration - Aggressive for max performance
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Mail (disabled for performance)
MAIL_MAILER=null

# Session - Redis for performance
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# MQTT Performance Settings - ULTRA HIGH SPEED
MQTT_USE_QUEUE=true
MQTT_AUTO_CREATE_MISSING=false
MQTT_BATCH_SIZE=200
MQTT_MAX_CONCURRENT=100
MQTT_RETRY_DELAY=0
MQTT_MAX_RETRIES=1
MQTT_QUEUE_TIMEOUT=120

# Performance Tuning - MAXIMUM SPEED
QUEUE_RETRY_AFTER=10
QUEUE_MAX_JOBS=10000
QUEUE_MEMORY_LIMIT=1024
QUEUE_TIMEOUT=900

# Database Performance
DB_POOL_SIZE=20
DB_TIMEOUT=30
DB_RETRY_TIMES=3

# Cache Performance
CACHE_TTL=3600
CACHE_PREFIX=egfollow_ultra

# Logging Performance (minimal logging for max speed)
LOG_QUERIES=false
LOG_MQTT_REQUESTS=false
LOG_DEBUG_ACTIONS=false

# Laravel Performance
CONFIG_CACHE_DRIVER=file
ROUTE_CACHE_DRIVER=file
VIEW_CACHE_DRIVER=file

# PHP Performance Settings (for reference - set in php.ini)
# memory_limit=512M
# max_execution_time=300
# opcache.enable=1
# opcache.memory_consumption=256
# opcache.interned_strings_buffer=16
# opcache.max_accelerated_files=20000
