BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
MQTT_USE_QUEUE=true

# Auto-create missing actions during processing
# Set to true to automatically create actions that don't exist
MQTT_AUTO_CREATE_MISSING=true

# Queue Configuration
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ✅ Laravel WebSockets (local, self-hosted, secured with Nginx reverse proxy)
PUSHER_APP_ID=local
PUSHER_APP_KEY=localkey123
PUSHER_APP_SECRET=localsecret123
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=egfollow.com
PUSHER_PORT=443
PUSHER_SCHEME=https

# ✅ Vite (Frontend JS config)
VITE_PUSHER_APP_KEY=localkey123
VITE_PUSHER_APP_CLUSTER=mt1
